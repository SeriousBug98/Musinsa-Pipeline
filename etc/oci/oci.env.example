# OCI 리소스 식별자 (oci CLI로 조회)
# oci iam tenancy get --query 'data.id'
OCI_COMPARTMENT_ID=ocid1.tenancy.oc1..xxxxxx

# oci iam availability-domain list --compartment-id $OCI_COMPARTMENT_ID
OCI_AVAILABILITY_DOMAIN=tPdx:AP-CHUNCHEON-1-AD-1

# oci network subnet list --compartment-id $OCI_COMPARTMENT_ID --query 'data[0].id'
OCI_SUBNET_ID=ocid1.subnet.oc1.ap-chuncheon-1.xxxxxx

# oci compute image list --compartment-id $OCI_COMPARTMENT_ID \
#   --operating-system "Canonical Ubuntu" --operating-system-version "22.04" \
#   --shape VM.Standard.A1.Flex --query 'data[0].id'
OCI_IMAGE_ID=ocid1.image.oc1.ap-chuncheon-1.xxxxxx

# 인스턴스 설정
INSTANCE_DISPLAY_NAME=musinsa-pipeline-2
OCPU_COUNT=4
MEMORY_GB=24
SSH_PUBLIC_KEY_PATH=~/.ssh/id_rsa.pub

# 스크립트 동작 설정
RETRY_INTERVAL_SEC=300     # 재시도 간격 (초). 300 이상 권장
MAX_ATTEMPTS_PER_RUN=100   # 1회 실행당 최대 시도 횟수
BACKOFF_MULTIPLIER=2       # 연속 실패 시 간격 증가 배율
MAX_BACKOFF_SEC=3600       # 최대 대기 시간 (초, 1시간)

# 성공 알림 (선택. 비워두면 터미널 출력만)
WEBHOOK_URL=               # Slack/Discord webhook URL
