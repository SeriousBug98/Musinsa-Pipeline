        {
          "datasource": { "type": "postgres", "uid": "musinsa-postgres" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  r.collected_at AS time,\n  b.name AS metric,\n  r.rank AS value\nFROM brand_rankings r\nJOIN brands b ON b.id = r.brand_id\nWHERE $__timeFilter(r.collected_at)\n  AND b.is_tracked = TRUE\nORDER BY time",
          "refId": "A",
          "sql": { "columns": [], "groupBy": [], "limit": 50 }
        }
      ],
