          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  f.collected_at AS time,\n  b.name AS metric,\n  f.fan_count AS value\nFROM brand_fans f\nJOIN brands b ON b.id = f.brand_id\nWHERE $__timeFilter(f.collected_at)\n  AND b.is_tracked = TRUE\nORDER BY time",
