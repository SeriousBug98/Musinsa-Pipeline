          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  np.product_name                                                       AS \"상품명\",\n  np.final_price                                                        AS \"판매가\",\n  np.discount_rate                                                      AS \"할인율(%)\",\n  np.review_count                                                       AS \"리뷰수\",\n  np.review_score                                                       AS \"평점\",\n  np.first_seen_at                                                      AS \"첫발견\",\n  np.sold_out_at                                                        AS \"품절시각\",\n  CASE WHEN np.is_sold_out THEN '품절' ELSE '판매중' END                 AS \"상태\",\n  CASE WHEN np.is_sold_out AND np.sold_out_at IS NOT NULL\n    THEN ROUND(EXTRACT(EPOCH FROM (np.sold_out_at - np.first_seen_at)) / 3600.0, 1)\n  END                                                                   AS \"품절소요(시간)\"\nFROM (\n  SELECT DISTINCT ON (product_id)\n    brand_id, product_name, final_price, discount_rate, first_seen_at, sold_out_at, is_sold_out, review_count, review_score\n  FROM new_products\n  WHERE first_seen_at > NOW() - INTERVAL '14 days'\n  ORDER BY product_id, first_seen_at DESC\n) np\nJOIN brands b ON b.id = np.brand_id\nWHERE b.name = '${brand}'\nORDER BY np.first_seen_at DESC",
