        {
          "datasource": { "type": "postgres", "uid": "musinsa-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  b.name AS \"브랜드\",\n  ROUND(\n    COUNT(*) FILTER (WHERE np.is_sold_out)::numeric\n    / NULLIF(COUNT(*), 0) * 100,\n  1) AS \"품절률\"\nFROM new_products np\nJOIN brands b ON b.id = np.brand_id\nWHERE np.first_seen_at > NOW() - INTERVAL '14 days'\nGROUP BY b.name\nHAVING COUNT(*) >= 3\nORDER BY \"품절률\" DESC\nLIMIT 20",
