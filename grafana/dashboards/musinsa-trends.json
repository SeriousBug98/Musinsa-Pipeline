      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "musinsa-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest_score AS (\n  SELECT brand_id, total_score\n  FROM brand_scores\n  WHERE scored_at = (SELECT MAX(scored_at) FROM brand_scores)\n),\ncur_rank AS (\n  SELECT DISTINCT ON (brand_id) brand_id, rank\n  FROM brand_rankings ORDER BY brand_id, collected_at DESC\n),\nold_rank AS (\n  SELECT DISTINCT ON (brand_id) brand_id, rank AS rank_7d\n  FROM brand_rankings\n  WHERE collected_at <= NOW() - INTERVAL '7 days'\n  ORDER BY brand_id, collected_at DESC\n),\ncur_fan AS (\n  SELECT DISTINCT ON (brand_id) brand_id, fan_count\n  FROM brand_fans ORDER BY brand_id, collected_at DESC\n),\nold_fan AS (\n  SELECT DISTINCT ON (brand_id) brand_id, fan_count AS fan_14d\n  FROM brand_fans\n  WHERE collected_at <= NOW() - INTERVAL '14 days'\n  ORDER BY brand_id, collected_at DESC\n),\nsoldout AS (\n  SELECT brand_id,\n    COUNT(*) AS total, COUNT(*) FILTER (WHERE is_sold_out) AS sold\n  FROM (\n    SELECT DISTINCT ON (product_id) brand_id, product_id, is_sold_out\n    FROM new_products\n    WHERE first_seen_at > NOW() - INTERVAL '14 days'\n    ORDER BY product_id, first_seen_at DESC\n  ) p\n  GROUP BY brand_id\n),\nsnap_14d AS (\n  SELECT brand_id,\n    SUM(mention_count) AS total_mentions,\n    MIN(best_rank)     AS best_rank_14d\n  FROM brand_snap_mentions\n  WHERE collected_at > NOW() - INTERVAL '14 days'\n    AND brand_id IS NOT NULL\n  GROUP BY brand_id\n)\nSELECT\n  b.name                                                          AS \"브랜드\",\n  cr.rank                                                         AS \"현재순위\",\n  or_.rank_7d                                                     AS \"7일전순위\",\n  (or_.rank_7d - cr.rank)                                         AS \"순위변동\",\n  cf.fan_count                                                    AS \"현재팬수\",\n  ROUND((cf.fan_count - of_.fan_14d)::numeric\n        / NULLIF(of_.fan_14d, 0) * 100, 1)                       AS \"14일팬증가(%)\",\n  COALESCE(s.total, 0)                                            AS \"신상품수(14일)\",\n  COALESCE(s.sold, 0)                                             AS \"품절수\",\n  ROUND(COALESCE(s.sold,0)::numeric / NULLIF(s.total,0) * 100,1) AS \"품절률(%)\",\n  COALESCE(sn.total_mentions, 0)                                  AS \"스냅언급(14일)\",\n  sn.best_rank_14d                                                AS \"스냅최고순위\",\n  ROUND(ls.total_score, 1)                                        AS \"종합점수\"\nFROM latest_score ls\nJOIN brands b          ON b.id = ls.brand_id\nLEFT JOIN cur_rank cr  ON cr.brand_id = ls.brand_id\nLEFT JOIN old_rank or_ ON or_.brand_id = ls.brand_id\nLEFT JOIN cur_fan cf   ON cf.brand_id = ls.brand_id\nLEFT JOIN old_fan of_  ON of_.brand_id = ls.brand_id\nLEFT JOIN soldout s    ON s.brand_id = ls.brand_id\nLEFT JOIN snap_14d sn ON sn.brand_id = ls.brand_id\nORDER BY ls.total_score DESC",
          "refId": "A",
          "sql": { "columns": [], "groupBy": [], "limit": 50 }
        }
      ],
      "title": "브랜드별 지표 비교",
      "type": "table"
    },
